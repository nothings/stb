# Dictionary for stbi_float_fuzzer: format magic for the dark decoders
# (HDR/Radiance, PSD, PIC, PNM) plus container framing.
# Escapes: only \\, \" and \xHH are valid in libFuzzer dictionaries.
hdr_radiance="#?RADIANCE\x0a"
hdr_format="FORMAT=32-bit_rle_rgbe"
hdr_res="-Y 4 +X 4"
hdr_rle2="\x02\x02"
psd_magic="8BPS"
psd_version="\x00\x01"
psd_depth16="\x00\x10"
pnm_p1="P1\x0a"
pnm_p2="P2\x0a"
pnm_p3="P3\x0a"
pnm_p4="P4\x0a"
pnm_p5="P5\x0a"
pnm_p6="P6\x0a"
pnm_maxval255="255\x0a"
pnm_maxval65535="65535\x0a"
pic_magic="\x53\x80\xf6\x34"
pic_pict="PICT"
pic_raw_packet="\x00\x08\x00\x07"
pic_rle_packet="\x00\x08\x01\x07"
png_magic="\x89PNG\x0d\x0a\x1a\x00"
jpg_soi="\xff\xd8\xff"
bmp_magic="BM"
exponent_128="\x80"
