# Dictionary for stb_c_lexer_fuzzer: C tokens that exercise the lexer's
# number parsing (decimal/hex/octal/float/C99-hex-float, suffixes), strings
# (single/double, multiline), comments and operator sets (all enabled by the
# fuzzer's STB_C_LEX_* configuration).
hex_int="0x1F"
hex_big="0xABCDEF"
octal_int="017"
decimal_int="12345"
int_suffix_u="123u"
int_suffix_ul="987654321UL"
int_suffix_ll="42lL"
decimal_float="3.14159"
float_exp="1.5e-10"
float_exp_pos="2E+8"
float_suffix="1.0f"
float_suffix_lf="0.5uulL"
hex_float="0x1Cp-3"
hex_float_no_int="0x.8p1"
float_no_decimal=".5"
float_trailing="5."
dq_string="\"hello world\""
sq_string="'single'"
multiline_dq="\"line1\x0aline2\""
char_literal="'a'"
escape_hex="\"\x41\""
comment_line="// comment"
comment_block="/* block\x0acomment */"
preprocessor_discard="#include <stdio.h>"
dollar_ident="$dollar_var"
ident="identifier_name"
op_eq_eq="=="
op_logical_and="&&"
op_logical_or="||"
op_shift_left="<<"
op_shift_right=">>"
op_increment="++"
op_decrement="--"
op_arrow="->"
op_arrow_eq="->="
op_bitwise_and_eq="&="
op_bitwise_or_eq="|="
op_bitwise_xor_eq="^="
op_plus_eq="+="
op_minus_eq="-="
op_times_eq="*="
op_div_eq="/="
op_mod_eq="%="
keyword_if="if"
keyword_for="for"
keyword_while="while"
keyword_return="return"
